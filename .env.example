# Copy to .env (never commit .env).
# Running with Docker (docker compose up)? Nothing here is required: the dashboard asks for the Clerk
# keys (login) on first open, and AI keys can be pasted on its AI providers page.

# ---- LLM (free key: https://aistudio.google.com/apikey)
# Gemini is used for reviews AND indexing (embeddings). Its free tier allows only ~20 review calls a day,
# so adding an OpenAI-compatible provider below as the fallback (or the primary) is strongly recommended.
GEMINI_API_KEY=
LLM_PROVIDER=gemini            # gemini | openrouter | openai (= any OpenAI-compatible endpoint, see below)
LLM_MODEL=gemini-3.5-flash     # model names live here only - check the provider's current free models
LLM_FALLBACK_PROVIDER=         # optional; default: the other of gemini/openrouter
LLM_FALLBACK_MODEL=            # model for the fallback provider, used when the primary fails
LLM_MIN_INTERVAL_MS=4500       # spacing between LLM calls (free-tier requests/minute)
OPENROUTER_API_KEY=

# Any OpenAI-compatible provider (free tiers listed on https://freellm.net), for example:
#   NVIDIA NIM (free key, phone verification, ~40 req/min): https://build.nvidia.com/settings/api-keys
#     OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1        model e.g. z-ai/glm-5.3
#   Groq (free key, no card, 30 req/min):                   https://console.groq.com/keys
#     OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1             model e.g. openai/gpt-oss-120b
# Then set LLM_FALLBACK_PROVIDER=openai + LLM_FALLBACK_MODEL=<model>  (or LLM_PROVIDER=openai + LLM_MODEL)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Paid providers (optional): LLM_PROVIDER=anthropic (Claude) or openai-api (OpenAI GPT), with their own keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_PROVIDER=          # gemini | openai-api; empty = Gemini if its key is set, else OpenAI (Claude has none)
# OPENAI_EMBEDDING_MODEL=      # default text-embedding-3-small
EMBEDDING_DIM=768              # must match the vector(...) column
# GEMINI_BASE_URL=             # tests/proxies only; default is the public Gemini API
# The keys above serve only the GitHub App admin (whoever created the app from the dashboard). Every
# other signed-in user adds their own keys on the "AI providers" page. true = share them with everyone.
# SHARED_LLM_KEYS=

# ---- Login (REQUIRED, Clerk): easiest is to leave these empty and paste the two keys on the
# dashboard's sign-in page the first time you open it (applied immediately, no rebuild).
# Keys set here take priority. Free app at https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- GitHub App
# Leave empty: the dashboard's "Create GitHub App" button creates the app and stores its keys in the database.
# Only fill these in to reuse an app you already made by hand.
GITHUB_APP_ID=
GITHUB_APP_SLUG=               # the name in https://github.com/apps/<slug>
GITHUB_APP_PRIVATE_KEY=        # PEM, with \n escaped
GITHUB_WEBHOOK_SECRET=

# ---- Webhooks (GitHub must reach this machine)
# docker compose creates a smee.io channel for you. Set SMEE_URL to keep a fixed one, or WEBHOOK_URL
# if the API already has a public address (then the smee container is not needed).
SMEE_URL=
WEBHOOK_URL=

# ---- Addresses (defaults work on one machine)
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000      # what your browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000
# CORS_ORIGINS=                         # extra dashboard origins, comma-separated (production)

# ---- Without Docker (pnpm dev): these point at the compose databases on localhost
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codereview
REDIS_URL=redis://localhost:6379
API_PORT=4000

# ---- Review worker
SEMGREP_CONFIG=auto

# ---- MCP (Claude Code integration)
CODEREVIEW_API_URL=http://localhost:4000
CODEREVIEW_API_KEY=
MCP_PORT=4100
