# Copy to .env (never commit .env)

# Core
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codereview
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_URL=http://localhost:3000
# Local only: lets requests without a token act as a "dev" user (curl/testing). Never enable when deployed.
AUTH_DEV_BYPASS=false

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=               # the name in https://github.com/apps/<slug>
GITHUB_APP_PRIVATE_KEY=        # PEM, with \n escaped
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Clerk (optional locally). Empty = the dashboard is open and the API needs AUTH_DEV_BYPASS=true.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# LLM (model names live here only - check the provider's current free models)
LLM_PROVIDER=gemini            # gemini | openrouter
LLM_MODEL=
LLM_FALLBACK_MODEL=            # model for the other provider, used if the primary fails
LLM_MIN_INTERVAL_MS=4500       # spacing between LLM calls (free-tier requests/minute)
GEMINI_API_KEY=
# GEMINI_BASE_URL=            # tests/proxies only; default is the public Gemini API
OPENROUTER_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=768              # must match the vector(...) column

# Review worker
SEMGREP_CONFIG=auto

# MCP
CODEREVIEW_API_URL=http://localhost:4000
CODEREVIEW_API_KEY=
MCP_PORT=4100
