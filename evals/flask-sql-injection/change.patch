+from flask import Flask, request
+import sqlite3
+
+app = Flask(__name__)
+
+@app.route("/user")
+def get_user():
+    name = request.args.get("name")
+    conn = sqlite3.connect("app.db")
+    cur = conn.execute("SELECT * FROM users WHERE name = '" + name + "'")
+    return str(cur.fetchall())
