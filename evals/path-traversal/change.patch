+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import express from 'express';
+
+const app = express();
+
+app.get('/download', async (req, res) => {
+  const file = String(req.query.name);
+  const data = await readFile(join('/srv/uploads', file));
+  res.send(data);
+});
